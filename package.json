{
  "name": "waifu-fit-player",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/prepare-demo.mjs",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "node scripts/prepare-demo.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "tsc -b && vitest run",
    "format": "prettier --write src tests scripts *.ts *.json *.html README.md docs",
    "format:check": "prettier --check src tests scripts *.ts *.json *.html README.md docs",
    "test:e2e:quick": "playwright test tests/app.spec.ts tests/project.spec.ts tests/practice-layout.spec.ts tests/practice-ribbons.spec.ts tests/note-overlap.spec.ts"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vite": "^7.2.0",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  }
}
